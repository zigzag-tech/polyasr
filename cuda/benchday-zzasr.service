[Unit]
Description=Benchday ASR server (CUDA / Qwen3-ASR-1.7B) — zz-tower0
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/benchday/asr-server-cuda
Environment=ASR_MODEL=Qwen/Qwen3-ASR-1.7B
Environment=ASR_DEVICE=cuda:0
Environment=ASR_DTYPE=bfloat16
Environment=ASR_PORT=8766
Environment=ASR_LOG_DIR=/home/ubuntu/benchday/asr-server-cuda/logs
# Hugging Face cache persists across restarts so model reload is fast.
Environment=HF_HOME=/home/ubuntu/.cache/huggingface
ExecStart=/home/ubuntu/benchday/asr-server-cuda/venv/bin/python /home/ubuntu/benchday/asr-server-cuda/server.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/.benchday/zzasr.log
StandardError=append:/home/ubuntu/.benchday/zzasr.err

[Install]
WantedBy=multi-user.target
